<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.w1th4d.jarplant</groupId>
    <artifactId>jarplant-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>jarplant-cli</module>
        <module>jarplant-implants</module>
        <module>jarplant-lib</module>
        <module>test-app-pojo</module>
        <module>test-app-spring-simple</module>
        <module>test-app-spring-complex</module>
        <module>test-implant-class</module>
        <module>test-implant-spring</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-test-apps.version>0.1.0-SNAPSHOT</spring-test-apps.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.w1th4d.jarplant</groupId>
                <artifactId>jarplant-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.w1th4d.jarplant</groupId>
                <artifactId>jarplant-implants</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.w1th4d.jarplant</groupId>
                <artifactId>jarplant-lib</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.w1th4d.jarplant</groupId>
                <artifactId>test-app-pojo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.w1th4d.jarplant</groupId>
                <artifactId>test-app-spring-simple</artifactId>
                <version>${spring-test-apps.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.w1th4d.jarplant</groupId>
                <artifactId>test-app-spring-complex</artifactId>
                <version>${spring-test-apps.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.w1th4d.jarplant</groupId>
                <artifactId>test-implant-class</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.w1th4d.jarplant</groupId>
                <artifactId>test-implant-spring</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.0.1</version>
                <configuration>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                    <goals>clean verify</goals>
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
